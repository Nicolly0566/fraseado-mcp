# Ambiente do Render; nunca publique valores de segredos no GitHub.
# Crie uma chave gratuita no console.groq.com e configure SOMENTE no Render.
GROQ_API_KEY=CONFIGURE_NO_RENDER
# Uma senha pessoal forte para o OAuth (>= 16 caracteres).
FRASEADO_LOGIN_PASSWORD=CONFIGURE_NO_RENDER
# Segredo aleatório (>= 32 caracteres); pode ser gerado automaticamente pelo render.yaml.
AUTH_JWT_SECRET=CONFIGURE_NO_RENDER
# Render configura RENDER_EXTERNAL_URL automaticamente; normalmente não precisa definir PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://fraseado-mcp.onrender.com
MAX_INPUT_MB=50
MAX_CONCURRENT_TRANSCRIPTIONS=1
ALLOWED_FILE_HOSTS=files.oaiusercontent.com,cdn.openai.com,chatgpt.com
